# ===== DATA (too large for git; keep directory placeholders) =====
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/groundtruth/*
!data/groundtruth/.gitkeep
data/blender/
*.npy
*.npz
*.h5
*.hdf5
*.exr

# ===== TRAINED MODELS =====
models/*
!models/.gitkeep
*.pth
*.pt
*.pkl
*.joblib

# ===== RESULTS =====
results/*
!results/figures/
!results/tables/
!results/manifests/
results/figures/*
results/tables/*
results/manifests/*
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/manifests/.gitkeep

# ===== BLENDER =====
blender/exports/
*.blend1
*.blend2

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/

# ===== VIRTUAL ENVIRONMENT =====
venv/
env/
.env

# ===== JUPYTER =====
.ipynb_checkpoints/
*.ipynb_metadata

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== LATEX =====
thesis/**/*.aux
thesis/**/*.log
thesis/**/*.out
thesis/**/*.toc
thesis/**/*.bbl
thesis/**/*.blg
thesis/**/*.synctex.gz
